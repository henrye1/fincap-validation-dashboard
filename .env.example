# SQL Server with the backup database. Same names as anchorpoint-ts/.env.secrets, so copy them across.
TYPEORM_HOST=localhost
TYPEORM_PORT=1433
TYPEORM_USERNAME=
TYPEORM_PASSWORD=
TYPEORM_TRUST_SERVER_CERT=true

# Database to audit (overridden by --db).
AUDIT_DB=aprs_za_abl_db

# Only needed for --ai.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
